NEAR_NETWORK=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
OWNER_ACCOUNT=ghostagent-vault-01.testnet
VAULT_CONTRACT=vault.ghostagent-vault-01.testnet
PAYEE_ACCOUNT=data-api.ghostagent-vault-01.testnet
MPC_SIGNER_CONTRACT=v1.signer-prod.testnet

# Full-access key of the vault owner account (ed25519:...)
OWNER_SECRET_KEY=
# Restricted function-call key the agent signs with (ed25519:...)
AGENT_SECRET_KEY=

# NEAR AI Cloud (https://cloud.near.ai -> API Keys)
NEARAI_API_KEY=
NEARAI_MODEL=

# Ethereum Sepolia (vault's chain-signature wallet)
EVM_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
EVM_EXPLORER=https://sepolia.etherscan.io
# Demo vendor the agent may pay in ETH (npm run upgrade creates one if empty)
EVM_PAYEE=
