{
  "name": "ghostagent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node server.js",
    "contract:test": "cd contracts/ghostvault && cargo test",
    "contract:build": "cd contracts/ghostvault && RUSTFLAGS=\"--cfg near\" cargo build --target wasm32-unknown-unknown --release && npx -y -p binaryen@123.0.0 wasm-opt -Oz --strip-debug --enable-bulk-memory --enable-sign-ext --enable-mutable-globals --enable-nontrapping-float-to-int target/wasm32-unknown-unknown/release/ghostvault.wasm -o target/ghostvault.opt.wasm",
    "setup": "node scripts/setup_vault.js",
    "approve-signer": "node scripts/approve_signer.js",
    "agent": "node agent/runner.js",
    "agent:inject": "node agent/runner.js --inject",
    "agent:tamper": "node agent/runner.js --tamper",
    "agent:forge": "node agent/runner.js --forge",
    "agent:jailbreak": "node agent/runner.js --jailbreak",
    "upgrade": "node scripts/upgrade_vault.js",
    "agent:evm": "node agent/runner.js --evm",
    "inspect-tx": "node scripts/inspect_tx.js"
  },
  "dependencies": {
    "@hot-labs/near-connect": "^0.11.4",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "lucide-react": "^1.16.0",
    "near-api-js": "^7.3.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.7"
  },
  "engines": {
    "node": ">=20.12"
  }
}
